{
  "name": "particle-js-v2",
  "version": "2.0.0-rc.1",
  "description": "GPU n-body particle simulator with user-defined force expressions.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "node scripts/check.mjs",
    "snap": "scripts/cpu-limit.sh node scripts/snap.mjs",
    "smoke": "scripts/cpu-limit.sh node scripts/smoke-interaction.mjs",
    "parity": "scripts/cpu-limit.sh node scripts/parity.mjs",
    "smoke:all": "scripts/cpu-limit.sh sh -c \"node scripts/parity.mjs && node scripts/snap.mjs --scenario galaxy,plasma,nuclei,crystal,quarks,hadrons,hydrogen,water,strong-blob,sandbox && node scripts/smoke-interaction.mjs\"",
    "cluster-stats": "scripts/cpu-limit.sh node scripts/cluster-stats.mjs",
    "snap:library": "scripts/cpu-limit.sh node scripts/snap.mjs --wait 2500 --scenario galaxy,plasma,nuclei,crystal,quarks,hadrons,welcome,the-egg,gravity,air,water-2,essential-elements,periodic-table,hydrogen,helium,water,strong-blob,standard-model,planetoid-formation,sandbox"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
