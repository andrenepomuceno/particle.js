{
  "format": "particle.js-v2/scenario",
  "version": 1,
  "id": "hydrogen",
  "name": "Hydrogen",
  "folder": "Elements",
  "description": "v1's first atom: a proton and a neutron bound by v1's force map 2 (pull inside ~52, push out to 200) and an electron held by 1/d Coulomb. v1 gave the electron a tangential speed of 16 with a random sense; here it starts on an orbit with that speed at the middle of its ring. Gravity (G = 1e-6) is negligible and omitted.",
  "seed": 1,
  "view": { "cameraDistance": 3000, "particleRadius": 30, "colorMode": "charge" },
  "settings": { "timeStep": 1, "mode2D": true },
  "forces": [
    {
      "name": "Nuclear (v1 force map 2)",
      "mode": "force",
      "range": "short",
      "cutoff": 200,
      "expression": "-k * n_i * n_j * (a * exp(-x / b) - c * x)",
      "params": [{ "name": "k", "value": 1 }, { "name": "a", "value": 1 }, { "name": "b", "value": 0.2 }, { "name": "c", "value": 1 }]
    },
    {
      "name": "Coulomb (v1 1/d)",
      "mode": "force",
      "range": "long",
      "softening": 0.5,
      "expression": "k * q_i * q_j / r",
      "params": [{ "name": "k", "value": 0.5 }]
    }
  ],
  "groups": [
    { "count": 1, "scale": false, "shape": { "type": "disk", "radius": 20 }, "mass": 18.36, "charge": 1, "nuclearCharge": 1 },
    { "count": 1, "scale": false, "shape": { "type": "disk", "radius": 20 }, "mass": 18.39, "charge": 0, "nuclearCharge": 1 },
    {
      "count": 1, "scale": false,
      "shape": { "type": "disk", "radius": 120, "innerRadius": 60 },
      "mass": 0.01,
      "charge": -1,
      "velocity": { "type": "orbit", "centralMass": 1, "G": 24320, "center": [0, 0, 0] }
    }
  ]
}
